# 8FitLab 環境変数テンプレート
# このファイルをコピーして .env.local を作り、実際の値を入れる（.env.local はコミットされない）
# Vercel では Project Settings > Environment Variables に同じ値を登録する

# --- Supabase（Assessment / Career Match Result / Event の保存） ---
# Supabase ダッシュボード > Settings > API Keys から取得
# Project URL（例: https://abcdefgh.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=
# 秘密キー（sb_secret_...）。サーバー専用。RLS を無視できるため NEXT_PUBLIC_ を付けてはいけない
SUPABASE_SECRET_KEY=
