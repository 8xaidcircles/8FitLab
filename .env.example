# 8FitLab 環境変数テンプレート
# このファイルをコピーして .env.local を作り、実際の値を入れる（.env.local はコミットされない）
# Vercel では Project Settings > Environment Variables に同じ値を登録する

# --- Supabase（Assessment / Career Match Result / Event の保存） ---
# Supabase ダッシュボード > Settings > API Keys から取得
# Project URL（例: https://abcdefgh.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=
# 秘密キー（sb_secret_...）。サーバー専用。RLS を無視できるため NEXT_PUBLIC_ を付けてはいけない
SUPABASE_SECRET_KEY=

# --- サイト ---
# canonical / sitemap / OG に使う本番URL（未設定なら https://8fitlab.com）
NEXT_PUBLIC_SITE_URL=

# --- 外部サービス（未設定ならタグを読み込まない。ブラウザに公開される ID なので NEXT_PUBLIC_ でよい） ---
# Google アナリティクス 4 の測定 ID（GA4 管理画面 > データストリーム。例: G-XXXXXXXXXX）
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google AdSense のサイト運営者 ID（AdSense 管理画面 > アカウント > アカウント情報。例: ca-pub-1234567890123456）
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
